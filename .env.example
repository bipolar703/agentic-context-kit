# ---------------------------------------------------------------------------
# agentic-context-kit configuration. Copy to .env (never commit .env).
#   cp .env.example .env        (or: make env)
# ---------------------------------------------------------------------------

# The ONLY directory MCP servers can see. Absolute path recommended.
# Default "." = the directory containing docker-compose.yml.
# Windows (Docker Desktop): use forward slashes, e.g. C:/Users/me/code/project
WORKSPACE_DIR=.

# ro = agent can read only (default, safest) | rw = agent may write via MCP
WORKSPACE_MODE=ro

# Run containers as your host user so bind-mount permissions behave.
# Linux/WSL: set to the output of `id -u` / `id -g`. Docker Desktop: 1000 is fine.
HOST_UID=1000
HOST_GID=1000

# Per-server resource limits (stdio tier)
MCP_MEM_LIMIT=512m
MCP_CPUS=1.0

# Image tags. Replace with @sha256 digests for reproducible, tamper-evident runs.
MCP_FILESYSTEM_TAG=latest
MCP_GIT_TAG=latest

# ---- Optional gateway profile (docker compose --profile gateway up -d) ----
GATEWAY_PORT=8811
# Comma-separated Docker MCP Catalog server names. duckduckgo makes outbound
# web requests; remove it if you need a fully offline stack.
GATEWAY_SERVERS=duckduckgo
# Generate with: openssl rand -hex 32
MCP_GATEWAY_AUTH_TOKEN=
MCP_GATEWAY_TAG=latest
SOCKET_PROXY_TAG=latest
